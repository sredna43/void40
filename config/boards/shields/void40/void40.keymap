#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
	combos {
		compatible = "zmk,combos";

		zmk_studio_combo {
			timeout-ms = <50>;
			key-positions = <0 1>;
			bindings = <&studio_unlock>;
		};

		bt_layer_combo {
			timeout-ms = <50>;
			key-positions = <36 46>;
			bindings = <&tog 5>;
		};

		to_qwerty {
			layers = <0>;
			timeout-ms = <50>;
			key-positions = <40 42>;
			bindings = <&to 1>;
		};

		to_dersium {
			layers = <1>;
			timeout-ms = <50>;
			key-positions = <40 42>;
			bindings = <&to 0>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		
		/* test { */
		/* 	bindings = <&bt BT_SEL 0 &kp B &kp L &none &none &none &none &none &none &none &none &none */
		/* 	&none &none &none &none &none &none &none &none &none &none &none &none  */
		/* 	&none &none &none &none &none &none &none &none &none &none &none &none */
		/* 	&none &none &none &none &none &none &none &none &none &none &kp Q>; */
		/* }; */

		dersium {
			bindings = <
				&kp ESC &kp B &kp L &kp D &kp C &kp V &kp J &kp Y &kp U &kp O &kp COMMA &kp BSPC
				&kp TAB &kp N &kp R &kp T &kp S &kp G &kp P &kp H &kp E &kp A &kp I &kp ENTER
				&kp LSHIFT &kp X &kp Q &kp M &kp W &kp Z &kp K &kp F &kp SEMI &kp SQT &kp DOT &kp RSHIFT
				&kp LCTRL &kp LGUI &kp LALT &mo 2 &mo 3 &kp SPACE &mo 3 &mo 2 &kp RALT &mo 4 &kp RCTRL
			>;
		};
		qwerty {
			bindings = <
				&kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
				&kp TAB &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L  &kp SEMI &kp ENTER
				&kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp QMARK &kp RSHIFT
				&kp LCTRL &kp LGUI &kp LALT &mo 2 &mo 3 &kp SPACE &mo 3 &mo 2 &kp RALT &mo 4 &kp RCTRL
			>;
		};
		symbols {
			bindings = <
				&kp ESC &kp GRAVE &kp AT &kp HASH &kp DOLLAR &kp PRCNT &kp CARET &kp LBRC &kp RBRC &kp STAR &kp QMARK &kp BSPC
				&kp TAB &kp SLASH &kp EXCL &kp MINUS &kp EQUAL &kp LT &kp GT &kp LPAR &kp RPAR &kp DOT  &kp BSLH &kp ENTER
				&kp LSHIFT &kp TILDE &kp PLUS &kp UNDER &kp SEMI &kp PIPE &kp AMPS &kp LBKT &kp RBKT &kp COMMA &kp SQT &kp RSHIFT
				&kp LCTRL &kp LGUI &kp LALT &to 0 &to 0 &kp SPACE &to 0 &to 0 &kp RALT &to 0 &kp RCTRL
			>;
		};
		functions {
			bindings = <
				&kp ESC &none &kp RIGHT &none &none &none &kp DOWN &none &none &none &none &kp BSPC
				&kp TAB &none &none &none &none &none &none &kp LEFT &none &none &none &kp ENTER
				&kp LSHIFT &none &none &none &none &none &kp UP &none &none &none &none &kp RSHIFT
				&kp LCTRL &none &none &none &none &kp SPACE &none &none &none &none &none &kp RCTRL
			>;
		};
		numbers {
			bindings = <
				&kp ESC &none &none &none &none &none &none &none &none &none &none &kp BSPC
				&kp TAB &none &none &none &none &none &none &none &none &none &none &kp ENTER
				&kp LSHIFT &none &none &none &none &none &none &none &none &none &none &kp RSHIFT
				&kp LCTRL &none &none &none &none &none &none &none &none &none &none &kp RCTRL
			>;
		};
		settings {
			bindings = <
				&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5 &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &bootloader
			>;
		};
	};
};
